<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowLightNavigationBar existe desde Android 8.1 (API 27); en API 26
         se hereda el tema base sin ese atributo. -->
    <style name="Theme.Nexcode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nexcode_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
