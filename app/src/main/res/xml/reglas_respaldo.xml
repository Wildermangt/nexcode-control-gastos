<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 o anterior: la base Room (movimientos y cuentas) y las
     preferencias no salen del teléfono en las copias de seguridad. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
